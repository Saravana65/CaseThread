# ==============================================================================
# CASETHREAD STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# Pre-configured defaults for isolated staging and verification deployments
# ==============================================================================

NODE_ENV=staging
PORT=5000
FRONTEND_PORT=3001
CLIENT_ORIGIN=http://localhost:3001,http://127.0.0.1:3001
REACT_APP_API_BASE_URL=http://localhost:5001/api/v1

# Staging Database Configuration
DB_HOST=database
DB_PORT=3306
DB_NAME=casethread_staging_db
DB_USER=casethread_staging_user
DB_PASSWORD=StagingDbSecretPassword2026!
MYSQL_ROOT_PASSWORD=StagingRootSecretPassword2026!

# JWT Secret (minimum 32 chars)
JWT_SECRET=StagingJwtSecretKeyMustBe32CharsLongForSecurity2026!
JWT_EXPIRES_IN=8h

# Engine & Storage
C_ENGINE_TIMEOUT_MS=8000
EVIDENCE_VAULT_PATH=/app/storage/vault
KNOWLEDGE_VAULT_PATH=/app/storage/private_knowledge_vault
MAX_FILE_SIZE_MB=50

# AI Intelligence
AI_INFERENCE_PROVIDER=deterministic
AI_MODEL_NAME=casethread-rag-v1
MAX_RETRIEVAL_CANDIDATES=5

# Background Workers
INGESTION_WORKER_ENABLED=false
METRICS_ENABLED=true

# Security Flags
ALLOW_MEMORY_STORE=false
USE_MEMORY_STORE=false
ENABLE_DEMO_CREDENTIALS=false
SEED_DEMO_DATA=false
