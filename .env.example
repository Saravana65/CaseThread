# ==============================================================================
# CASETHREAD SYSTEM ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and provide strong cryptographic secrets before
# running the system in production.
# NEVER commit your actual '.env' file into Git source control.
# ==============================================================================

# Application Environment (development | test | production)
NODE_ENV=production
PORT=5000

# Client Application / CORS Configuration (comma-separated origins permitted)
CLIENT_ORIGIN=http://localhost:3000
REACT_APP_API_BASE_URL=http://localhost:5000/api/v1
FRONTEND_PORT=3000

# MySQL Database Configuration
DB_HOST=database
DB_PORT=3306
DB_NAME=casethread_db
DB_USER=casethread_user
DB_PASSWORD=replace_with_a_strong_database_password_min_16_chars
MYSQL_ROOT_PASSWORD=replace_with_a_strong_root_password_min_16_chars

# JWT Authentication Security (MUST be >= 32 characters in production)
JWT_SECRET=replace_with_a_cryptographically_secure_random_key_min_32_characters_long
JWT_EXPIRES_IN=12h

# C Core DSA Engine Configuration
C_ENGINE_TIMEOUT_MS=8000
C_ENGINE_BINARY_PATH=

# Digital Evidence Vault & File Storage
EVIDENCE_VAULT_PATH=/app/storage/vault
MAX_FILE_SIZE_MB=50

# API Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_ANALYSIS_MAX=30

# Security & Isolation Flags (STRICTLY PROHIBITED in production)
# In production, MemoryStore fallback and demo credentials are permanently blocked.
ALLOW_MEMORY_STORE=false
USE_MEMORY_STORE=false
ENABLE_DEMO_CREDENTIALS=false
SEED_DEMO_DATA=false
