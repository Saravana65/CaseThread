# ==============================================================================
# CASETHREAD PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Production parameters requiring cryptographically generated secrets
# ==============================================================================

NODE_ENV=production
PORT=5000
FRONTEND_PORT=3000
CLIENT_ORIGIN=https://investigations.casethread.police.gov
REACT_APP_API_BASE_URL=https://investigations.casethread.police.gov/api/v1

# Production Database Credentials (Must be strong, unique, >= 16 chars)
DB_HOST=database
DB_PORT=3306
DB_NAME=casethread_prod_db
DB_USER=casethread_prod_app
DB_PASSWORD=GENERATE_STRONG_DATABASE_PASSWORD_MIN_24_CHARS
MYSQL_ROOT_PASSWORD=GENERATE_STRONG_ROOT_PASSWORD_MIN_32_CHARS

# JWT Secret (Cryptographically random, >= 64 chars recommended)
JWT_SECRET=GENERATE_CRYPTOGRAPHICALLY_RANDOM_KEY_AT_LEAST_64_CHARACTERS
JWT_EXPIRES_IN=8h

# Native C Core DSA Engine
C_ENGINE_TIMEOUT_MS=8000
C_ENGINE_BINARY_PATH=/app/core-engine/bin/casethread_engine

# Digital Evidence Vault & File Storage
EVIDENCE_VAULT_PATH=/app/storage/vault
KNOWLEDGE_VAULT_PATH=/app/storage/private_knowledge_vault
MAX_FILE_SIZE_MB=50

# AI Intelligence & Retrieval Configuration
AI_INFERENCE_PROVIDER=deterministic
AI_MODEL_NAME=casethread-rag-v1
MAX_RETRIEVAL_CANDIDATES=5

# Controlled Ingestion
INGESTION_WORKER_ENABLED=true
INGESTION_INTERVAL_MS=3600000

# Observability
METRICS_ENABLED=true

# Strict Security
ALLOW_MEMORY_STORE=false
USE_MEMORY_STORE=false
ENABLE_DEMO_CREDENTIALS=false
SEED_DEMO_DATA=false
