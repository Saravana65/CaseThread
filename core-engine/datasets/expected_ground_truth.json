{
  "description": "CASETHREAD Phase 12 - Independent Ground Truth Specifications for Controlled Investigation Datasets",
  "version": "1.0.0-phase12",
  "evaluation_criteria": {
    "gap_detection": ["MISSING_TIMESTAMP", "MISSING_SOURCE", "UNVERIFIED_OBSERVATION", "INCOMPLETE_LOCATION", "DISCONNECTED_CLUSTER"],
    "timeline_anomalies": ["IMPOSSIBLE_TRAVEL_SPEED", "OVERLAPPING_EVENT_UNVERIFIED"],
    "lead_scoring_formula": "Score = 0.40 * Confidence + 0.30 * Centrality + 0.30 * GapWeight",
    "graph_metrics": ["nodes_processed", "edges_evaluated", "connected_components", "isolated_nodes_count"]
  },
  "scenarios": {
    "scenario_missing_person": {
      "case_id": 101,
      "dataset_file": "scenario_missing_person.json",
      "expected_gaps": {
        "total_count": 4,
        "categories": ["MISSING_TIMESTAMP", "MISSING_SOURCE", "UNVERIFIED_OBSERVATION", "INCOMPLETE_LOCATION"]
      },
      "expected_timeline_anomalies": {
        "total_count": 1,
        "types": ["IMPOSSIBLE_TRAVEL_SPEED"]
      },
      "expected_graph": {
        "nodes_processed": 9,
        "connected_components": 3,
        "isolated_nodes_count": 2,
        "path_found": true,
        "path_length_hops": 3
      },
      "expected_leads": {
        "min_count": 1,
        "top_lead_target": "Rohan Verma (Colleague)"
      }
    },
    "scenario_warehouse_intrusion": {
